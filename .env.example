# Groq / DSPy
GROQ_API_KEY=
GROQ_MODEL="groq/openai/gpt-oss-120b"
OPENAI_API_BASE="https://api.groq.com/openai/v1"
# Optional mirror for libs that look for it
OPENAI_API_KEY=

#Logfire
LOGFIRE_TOKEN=
SERVICE_NAME="chip-api"
ENV="development"
LOGFIRE_SEND_TO_LOGFIRE="true"
LOGFIRE_CONSOLE="true"

# Loop Messaging
LOOP_WEBHOOK_AUTH=
LOOP_SEND_URL="https://server.loopmessage.com/api/v1/message/send/"
LOOP_AUTHORIZATION=
LOOP_SECRET_KEY=
LOOP_SENDER_NAME=

# Persistence (optional)
SUPABASE_URL=
SUPABASE_KEY=

# Server
APP_ENV=development
LOG_LEVEL=INFO
# PORT is set by Railway